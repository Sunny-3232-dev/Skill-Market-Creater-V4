{
  "name": "skill-market-creator-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit && tsc --noEmit -p worker",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:cf": "tsc && VITE_GEMINI_PROXY=1 vite build",
    "dev:cf": "npm run build:cf && wrangler dev",
    "deploy": "npm run build:cf && wrangler deploy",
    "cf:types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "wrangler": "^4.129.0"
  }
}
