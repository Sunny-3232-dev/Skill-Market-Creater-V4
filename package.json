{
  "name": "skill-market-creator-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:direct": "VITE_GEMINI_PROXY=0 vite",
    "lint": "tsc --noEmit && tsc --noEmit -p worker",
    "build": "tsc && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "npm run build && npm start",
    "pack": "rm -f skill-market-creator-to-aistudio.zip && git ls-files --cached | zip -X skill-market-creator-to-aistudio.zip -@",
    "build:cf": "tsc && vite build",
    "dev:cf": "npm run build:cf && wrangler dev --local",
    "deploy": "npm run build:cf && wrangler deploy",
    "cf:types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22"
  }
}
